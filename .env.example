# Public URL of the site (no trailing slash). Used in emails and Stripe redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe: Developers > API keys, and the signing secret of the webhook endpoint
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# OpenAI: writes the readings and the member memory
OPENAI_API_KEY=
# Optional. Defaults to gpt-5-mini.
# OPENAI_MODEL=

# Resend: sends the emails. The sender's domain must be verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Seraphova <readings@yourdomain.com>"

# Any long random strings (e.g. `openssl rand -hex 32`).
# CRON_SECRET protects the daily job; Vercel sends it automatically.
CRON_SECRET=
# APP_SECRET signs the unsubscribe links.
APP_SECRET=

# Password for the dashboard at /admin. Leave empty to keep the dashboard closed.
ADMIN_PASSWORD=
